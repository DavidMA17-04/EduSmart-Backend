# Aplicacion
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Base de datos (MySQL)
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=changeme
DB_DATABASE=EduSmart
DB_SYNCHRONIZE=false

# JWT
JWT_SECRET=changeme
JWT_EXPIRATION=8h

# Admin local (Sprint 1)
ADMIN_EMAIL=admin@ctphojancha.ed.cr
ADMIN_PASSWORD=Admin1234

JWT_REFRESH_SECRET=changeme
JWT_REFRESH_EXPIRATION=7d

# Correo (PBI-16 verificación de cuenta)
# Stub si MAIL_HOST está vacío, es smtp.example.com, o faltan USER/PASSWORD.
# Mailtrap (pruebas): MAIL_HOST=sandbox.smtp.mailtrap.io  MAIL_PORT=2525
# Pegá Username/Password del inbox de Mailtrap en MAIL_USER / MAIL_PASSWORD (solo en .env local).
MAIL_HOST=smtp.example.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=no-reply@edusmart.local

# URL pública del frontend (enlace en el correo de verificación)
APP_PUBLIC_URL=http://localhost:5173

# Pepper opcional para hashear códigos OTP (si se omite, se usa JWT_SECRET)
# VERIFICATION_CODE_PEPPER=change-me-unique-pepper
