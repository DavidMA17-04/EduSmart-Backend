# Aplicacion
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Base de datos (MySQL)
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=changeme
DB_DATABASE=EduSmart
DB_SYNCHRONIZE=false

# JWT
JWT_SECRET=changeme
JWT_EXPIRATION=8h

# Admin local (Sprint 1)
ADMIN_EMAIL=admin@ctphojancha.ed.cr
ADMIN_PASSWORD=Admin1234

JWT_REFRESH_SECRET=changeme
JWT_REFRESH_EXPIRATION=7d

# Correo (PBI-16 verificación + PBI-18 recuperación de contraseña)
# Stub si MAIL_HOST está vacío, es smtp.example.com, o faltan USER/PASSWORD.
#
# Brevo (llega al correo real del usuario) — recomendado:
#   1) Cuenta en https://www.brevo.com
#   2) Settings → SMTP & API → copiar Login (xxx@smtp-brevo.com) y crear SMTP key
#   3) Senders → verificar el correo que pondrás en MAIL_FROM
#   4) Pegar Login/SMTP key abajo (solo en .env local; nunca en git)
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=587
# MAIL_USER=xxx@smtp-brevo.com
# MAIL_PASSWORD=tu-smtp-key-de-brevo
# MAIL_FROM=tu-correo-verificado@gmail.com
# MAIL_FROM_NAME=EduSmart CTP Hojancha
#
# Mailtrap (solo sandbox; NO llega a Gmail):
# MAIL_HOST=sandbox.smtp.mailtrap.io  MAIL_PORT=2525
MAIL_HOST=smtp-relay.brevo.com
MAIL_PORT=587
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=EduSmart CTP Hojancha

# URL pública del frontend (enlace en correos de verificación / reset)
APP_PUBLIC_URL=http://localhost:5173

# Pepper opcional para hashear códigos OTP (si se omite, se usa JWT_SECRET)
# VERIFICATION_CODE_PEPPER=change-me-unique-pepper
