# Aplicacion
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Base de datos (MySQL)
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=changeme
DB_DATABASE=EduSmart
DB_SYNCHRONIZE=false
# Base en la nube (Aiven): DB_SSL=true cifra la conexión. Opcional: DB_SSL_CA con el
# certificado CA de Aiven (texto PEM; los saltos de línea pueden escribirse como \n).
# DB_SSL=true
# DB_SSL_CA=

# JWT
# En producción (NODE_ENV=production) el backend NO arranca si JWT_SECRET o
# JWT_REFRESH_SECRET tienen menos de 32 caracteres, usan un valor de ejemplo
# (changeme) o son iguales entre sí. Genere cada uno con:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
JWT_SECRET=changeme
JWT_EXPIRATION=8h

# Admin local (Sprint 1)
ADMIN_EMAIL=admin@ctphojancha.ed.cr
# En producción es obligatoria al crear el administrador inicial: 12+ caracteres y
# distinta de Admin1234. Ese primer ingreso obliga a cambiar la contraseña.
ADMIN_PASSWORD=Admin1234

JWT_REFRESH_SECRET=changeme
JWT_REFRESH_EXPIRATION=7d

# Correo (PBI-16 verificación + PBI-18 recuperación de contraseña)
# SMTP genérico vía MAIL_*. Sin SMTP completo (host vacío, smtp.example.com,
# o sin USER/PASSWORD) el envío FALLA (no hay éxito silencioso).
#
# Ejemplo Gmail (prueba local — App Password, solo en .env local):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_SECURE=true
# MAIL_USER=tu-correo@gmail.com
# MAIL_PASSWORD=tu-app-password
# MAIL_FROM=tu-correo@gmail.com
# MAIL_FROM_NAME=EduSmart
#
# Ejemplo Brevo (también válido cambiando solo estas variables):
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=465
# MAIL_SECURE=true
# MAIL_USER=xxx@smtp-brevo.com
# MAIL_PASSWORD=
# MAIL_FROM=sender-verificado@ejemplo.com
# MAIL_FROM_NAME=EduSmart CTP Hojancha
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=EduSmart

# URL pública del frontend (enlace en correos de verificación / reset)
APP_PUBLIC_URL=http://localhost:5173

# QA local: omitir día/ventana al iniciar asistencia desde horario.
# true|false; si se omite, se relaja solo con NODE_ENV=development.
ATTENDANCE_RELAX_SCHEDULE_GATES=true

# Límite de intentos fallidos de login (activo siempre con NODE_ENV=production;
# en desarrollo solo con LOGIN_RATE_LIMIT=true). Valores por defecto:
# LOGIN_MAX_ATTEMPTS=5          por cédula
# LOGIN_MAX_ATTEMPTS_PER_IP=60  por IP (alto: mismo Wi-Fi = misma IP)
# LOGIN_LOCK_MINUTES=15

# Documentación /api/docs: visible en desarrollo; en producción solo con SWAGGER_ENABLED=true.

# En producción CORS_ORIGIN es obligatorio y no puede ser "*" (p. ej. https://edusmart.vercel.app).

# Pepper opcional para hashear códigos OTP (si se omite, se usa JWT_SECRET)
# VERIFICATION_CODE_PEPPER=change-me-unique-pepper
