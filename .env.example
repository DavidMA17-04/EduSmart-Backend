# Aplicacion
PORT=3000
NODE_ENV=development
CORS_ORIGIN=http://localhost:5173,http://127.0.0.1:5173

# Base de datos (MySQL)
DB_HOST=localhost
DB_PORT=3307
DB_USERNAME=root
DB_PASSWORD=changeme
DB_DATABASE=EduSmart
DB_SYNCHRONIZE=false

# JWT
JWT_SECRET=changeme
JWT_EXPIRATION=8h

# Admin local (Sprint 1)
ADMIN_EMAIL=admin@ctphojancha.ed.cr
ADMIN_PASSWORD=Admin1234

JWT_REFRESH_SECRET=changeme
JWT_REFRESH_EXPIRATION=7d

# Correo (PBI-16 verificación + PBI-18 recuperación de contraseña)
# SMTP genérico vía MAIL_*. Sin SMTP completo (host vacío, smtp.example.com,
# o sin USER/PASSWORD) el envío FALLA (no hay éxito silencioso).
#
# Ejemplo Gmail (prueba local — App Password, solo en .env local):
# MAIL_HOST=smtp.gmail.com
# MAIL_PORT=465
# MAIL_SECURE=true
# MAIL_USER=tu-correo@gmail.com
# MAIL_PASSWORD=tu-app-password
# MAIL_FROM=tu-correo@gmail.com
# MAIL_FROM_NAME=EduSmart
#
# Ejemplo Brevo (también válido cambiando solo estas variables):
# MAIL_HOST=smtp-relay.brevo.com
# MAIL_PORT=465
# MAIL_SECURE=true
# MAIL_USER=xxx@smtp-brevo.com
# MAIL_PASSWORD=
# MAIL_FROM=sender-verificado@ejemplo.com
# MAIL_FROM_NAME=EduSmart CTP Hojancha
MAIL_HOST=smtp.example.com
MAIL_PORT=465
MAIL_SECURE=true
MAIL_USER=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_FROM_NAME=EduSmart

# URL pública del frontend (enlace en correos de verificación / reset)
APP_PUBLIC_URL=http://localhost:5173

# Pepper opcional para hashear códigos OTP (si se omite, se usa JWT_SECRET)
# VERIFICATION_CODE_PEPPER=change-me-unique-pepper
